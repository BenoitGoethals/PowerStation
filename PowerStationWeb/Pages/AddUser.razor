@page "/AddUser"
@using PowerStationInfrastructure.Services.AD
@using Microsoft.AspNetCore.Components
@using PowerStationDomain.models.AD
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Inputs;
@using Syncfusion.Blazor.Buttons;
@using Syncfusion.Blazor.Calendars;
@using System.ComponentModel.DataAnnotations;
@using System.Globalization
@using FluentValidation
@using Syncfusion.Blazor.Inputs
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Identity
@using PowerStationApplicationCore
@using PowerStationApplicationCore.Validators
@using PowerStationDomain.models
@using PowerStationInfrastructure.Services.AD
@using PowerStationDomain.models
@using PowerStationInfrastructure.helpers
@using PowerStationInfrastructure.Services;
@using PowerStationInfrastructure.Services.AD
@inject IAdServiceUser AdService
@inject IAdServiceSecurity AdServiceSecurityGroups

@inject HttpClient Http
@inject IJSRuntime JS
<div class="col-lg-12 control-section">

    <div class="control-wrapper">
        @if (string.IsNullOrEmpty(_message))
        {
            <EditForm Model="@_user" OnValidSubmit="@OnValidSubmit" OnInvalidSubmit="@OnInvalidSubmit">
                <DataAnnotationsValidator />

                <div class="row material">
                  @*  <div class="col-xs-6 col-sm-6 col-lg-6 col-md-6">
                        <SfTextBox CssClass="e-outline" ID="Name" @bind-Value="@_user.Name" FloatLabelType="@FloatLabelType.Auto" Width="200" Placeholder="Enter a name"></SfTextBox>
                        <ValidationMessage For="@(() => _user.Name)" />
                    </div>*@
                    <div class="col-xs-6 col-sm-6 col-lg-6 col-md-6">

                        <SfTextBox CssClass="e-outline" ID="Surname" @bind-Value="@_user.Surname" FloatLabelType="@FloatLabelType.Auto" Width="200" Placeholder="Enter an Surname"></SfTextBox>
                        <ValidationMessage For="@(() => _user.Surname)" />
                    </div>
                  <div class="col-xs-6 col-sm-6 col-lg-6 col-md-6">

                      <SfTextBox CssClass="e-outline" ID="GivenName" @bind-Value="@_user.GivenName" FloatLabelType="@FloatLabelType.Auto" Width="200" Placeholder="Enter an GivenName"></SfTextBox>
                      <ValidationMessage For="@(() => _user.GivenName)" />
                  </div>
                </div>
                <div class="row material">
                    <div class="col-xs-6 col-sm-6 col-lg-6 col-md-6">

                        <SfTextBox CssClass="e-outline" ID="MiddleName" @bind-Value="@_user.MiddleName" FloatLabelType="@FloatLabelType.Auto" Width="200" Placeholder="Enter an MiddleName"></SfTextBox>
                        <ValidationMessage For="@(() => _user.MiddleName)" />
                    </div>
                <div class="col-xs-6 col-sm-6 col-lg-6 col-md-6">
                        <SfDropDownList TValue="string" TItem="SecurityGroup" Placeholder="e.g. Australia" Width="300px" @bind-Value="@SecurityGroup.Name" DataSource="@_groups">
                        <DropDownListFieldSettings Value="Name"></DropDownListFieldSettings> 
                    </SfDropDownList> 
                        <ValidationMessage For="()=>SecurityGroup.Name"></ValidationMessage>
                </div>
                </div>
                <div class="row material">
                    <div class="col-xs-6 col-sm-6 col-lg-6 col-md-6">

                        <SfTextBox CssClass="e-outline" ID="Company" @bind-Value="@_user.Company" FloatLabelType="@FloatLabelType.Auto" Width="200" Placeholder="Enter an Company"></SfTextBox>
                        <ValidationMessage For="@(() => _user.Company)" />
                    </div>
                    <div class="col-xs-6 col-sm-6 col-lg-6 col-md-6">

                        <SfTextBox CssClass="e-outline" ID="EmailAddress" @bind-Value="@_user.EmailAddress" FloatLabelType="@FloatLabelType.Auto" Width="200" Placeholder="Enter an email"></SfTextBox>
                        <ValidationMessage For="@(() => _user.EmailAddress)" />
                    </div>
                </div>

                <div class="row material">
                    <div class="col-xs-6 col-sm-6 col-lg-6 col-md-6">

                        <SfTextBox CssClass="e-outline" ID="Department" @bind-Value="@_user.Department" FloatLabelType="@FloatLabelType.Auto" Width="200" Placeholder="Enter an Department"></SfTextBox>
                        <ValidationMessage For="@(() => _user.Department)" />
                    </div>
                    <div class="col-xs-6 col-sm-6 col-lg-6 col-md-6">

                        <SfTextBox CssClass="e-outline" ID="Description" @bind-Value="@_user.Description" FloatLabelType="@FloatLabelType.Auto" Width="200" Placeholder="Enter an Description"></SfTextBox>
                        <ValidationMessage For="@(() => _user.Description)" />
                    </div>
                </div>

                <div class="row material">
                    <div class="col-xs-6 col-sm-6 col-lg-6 col-md-6">
                        <SfTextBox CssClass="e-outline" ID="VoiceTelephoneNumber" @bind-Value="@_user.VoiceTelephoneNumber" FloatLabelType="@FloatLabelType.Auto" Width="150" Placeholder="Enter an VoiceTelephoneNumber"></SfTextBox>
                        <ValidationMessage For="@(() => _user.VoiceTelephoneNumber)" />
                    </div>
                    <div class="col-xs-6 col-sm-6 col-lg-6 col-md-6">
                        <SfTextBox CssClass="e-outline" ID="Mobile" @bind-Value="@_user.Mobile" FloatLabelType="@FloatLabelType.Auto" Width="150" Placeholder="Enter an Mobile"></SfTextBox>
                        <ValidationMessage For="@(() => _user.Mobile)" />
                    </div>
                </div>

                <div class="row material">
                    <div class="col-xs-6 col-sm-6 col-lg-6 col-md-6">
                        <SfTextBox Placeholder="Password" @bind-Value="@_user.PasswordSet.Password" FloatLabelType="@FloatLabelType.Auto" Type="InputType.Password"></SfTextBox>
                        <ValidationMessage For="@(() => _user.PasswordSet.Password)" />
                    </div>
                    <div class="col-xs-6 col-sm-6 col-lg-6 col-md-6">
                        <SfTextBox Placeholder="Confirm Password" @bind-Value="@_user.PasswordSet.ConfirmPassword" FloatLabelType="@FloatLabelType.Auto" Type="InputType.Password"></SfTextBox>
                        <ValidationMessage For="@(() => _user.PasswordSet.ConfirmPassword)" />
                    </div>
                </div>



                <div class="row material">
                    <div class="col-xs-6 col-sm-6 col-lg-6 col-md-6">
                        <SfDatePicker TValue="DateTime?" Placeholder="Choose a expering Date" Min="@minDate" Max="@maxDate">                 </SfDatePicker>
                    </div>

                </div>
                <div class="row material">
                    <div class="col-xs-6 col-sm-6 col-lg-6 col-md-6">
                        <label class="form-label" for="Enabled">Enabled</label>
                        <SfCheckBox CssClass="e-outline" FloatLabelType="@FloatLabelType.Auto" ID="Enabled" @bind-Checked="@_user.Enabled"></SfCheckBox>
                    </div>
                </div>


                <div class="row material">

                    <div class="col-xs-6 col-sm-6 col-lg-6 col-md-6">
                        <SfDropDownList TValue="AdUserType" TItem="AdUserType" PopupHeight="230px" DataSource="@_listTypes" Placeholder="Select a Type">

                        </SfDropDownList>

                    </div>

                </div>
                <div class="row material">
                    <div class="col-xs-6 col-sm-6 col-lg-6 col-md-6">
                        <label class="col-form-label">Upload Image:</label>
                        <SfUploader ID="UploadFiles" AllowedExtensions=".png,.jpeg,.jpg" AllowMultiple="false">
                            <UploaderEvents ValueChange="onChange"></UploaderEvents>
                            <UploaderTemplates>
                                <Template Context="HttpContext">
                                    <table>
                                        <tr>
                                          @*  <td>
                                                <img class="upload-image" alt="Preview Image @(HttpContext.Name)"
                                                 src="@PhotoFname">
                                            </td>*@
                                            <td>
                                                <div style="padding: 7px;">
                                                    <h5 title="@(HttpContext.Name)">@(HttpContext.Name)</h5>
                                                    <i>@(HttpContext.Size) Bytes</i>
                                                </div>
                                            </td>
                                        </tr>
                                    </table>
                                    <span class="e-icons e-file-remove-btn remove" id="removeIcon" title="Remove"></span>
                                    @*<span class="e-upload-icon e-icons e-file-remove-btn" title="Upload" id="iconUpload" @onclick="@uploadFile"></span>*@
                                </Template>
                            </UploaderTemplates>
                        </SfUploader>
                    </div>
                </div>

                -


                <div class="submit-btn">
                    <SfButton type="submit" IsPrimary="true">Submit</SfButton>
                    @_message
                </div>

            </EditForm>

        }
        else
        {
            <div class="alert alert-success">
                @_message
            </div>
        }
    </div>
</div>
<style>

    .content-wrapper {
        width: 90%;
        margin: 0 auto;
        min-width: 85px;
    }

    .submit-btn {
        display: flex;
        justify-content: left;
    }


    b.example-label {
        font-size: 14px;
    }

    .content-wrapper div.row {
        padding: 15px 0px;
    }

    .small-textbox {
        padding-top: 5px;
    }

    .tailwind .small-textbox,
    .tailwind-dark .small-textbox {
        padding-top: 3px;
    }

    .e-bigger .small-textbox {
        padding-top: 10px;
    }

    .tailwind .e-bigger .small-textbox,
    .tailwind-dark .e-bigger .small-textbox {
        padding-top: 1px;
    }

    @@media only screen and (max-width: 480px) {
        .content-wrapper {
            width: 92%;
        }

        .col-xs-6,
        .col-xs-4,
        .col-xs-12 {
            padding: 10px 5px;
            width: 100%;
        }

        .content-wrapper div.row {
            padding: 0px;
        }
    }

    .fabric .row.material,
    .bootstrap .row.material,
    .bootstrap4 .row.material,
    .bootstrap5 .row.material,
    .highcontrast .row.material,
    .tailwind .row.material,
    .fluent .row.material,
    .fabric-dark .row.material,
    .bootstrap-dark .row.material,
    .bootstrap5-dark .row.material,
    .tailwind-dark .row.material,
    .fluent-dark .row.material {
        display: none;
    }

    @@font-face {
        font-family: 'Uploader_Icon';
        src: url(data:application/x-font-ttf;charset=utf-8;base64,) format('truetype');
        font-weight: normal;
        font-style: normal;
    }

    .e-upload .e-upload-files .e-icons.e-upload-icon {
        font-family: 'Uploader_Icon';
        speak: none;
        font-size: 16px;
        right: 35px;
        line-height: 1;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

        .e-upload .e-upload-files .e-icons.e-upload-icon::before {
            content: '\e700';
        }

    .upload-image {
        width: 150px;
        height: 150px;
        display: inline-flex;
        background-size: contain;
        margin: 7px;
        text-align: center;
        line-height: 10;
        border-radius: 5px;
    }

    .validation-message {
        color: red;
        padding: 5px 0px 0px;
    }

    div {
        margin-bottom: 10px;
    }

    label {
        display: inline-block;
        width: 110px;
        color: #777777;
    }

    input {
        padding: 5px 10px;
    }
</style>
@code {

    public byte[]? content;
  
    public DateTime minDate { get; set; } = DateTime.Now;
    public DateTime maxDate { get; set; } = DateTime.Today.AddYears(1);
    public string PhotoFname { get; set; }
    private SecurityGroup SecurityGroup = new SecurityGroup();
    private string _message = string.Empty;
    private User _user = new User();

    private readonly List<AdUserType> _listTypes = Enum.GetValues(typeof(AdUserType)).OfType<AdUserType>().ToList();

    private  List<SecurityGroup> _groups;
    private AdUserType _typepAdValue { get; set; }
  

    public void onChange(UploadChangeEventArgs args)
    {
         
        if (args.Files[0]!=null){

            content = args.Files[0].Stream.ToArray();
            

        }
    }


    protected override void OnInitialized()
    {
        _groups = AdServiceSecurityGroups.All();
    }


    async void OnValidSubmit()
    {

        var userValidator = new UserValidator();
        _user.UserType = _typepAdValue;
        _user.AddMember(SecurityGroup);
        _user.Populate();
        var result = await userValidator.ValidateAsync(_user);
        if (!result.IsValid)
        {
            _message = "Validation Error ";
            result.Errors.ForEach(c => { _message += Environment.NewLine + c.ErrorMessage; });

        }
        else if (!_user.PasswordSet.AreEqual())
        {
            _message = "Password are not the same";
        }
        else
        {
            if (_user.SamAccountName != null && AdService.Get(_user.SamAccountName) != null)
            {
                _message = "User already exists";
            }
            else
            {
                var ret = AdService.Add(_user);
                if (ret == false)
                {
                    _message = "error";
                }
                else
                {
                    if (_user.SamAccountName != null && content != null) AdHelper.InsertPicture(_user.SamAccountName, content);
                    _message = "Form Submitted Successfully!";
                    _user = new User();
                }
            }

        }
        await Task.Delay(2000);

        StateHasChanged();
    }

    private void OnInvalidSubmit()
    {
        //  Message = string.Empty;
    }
}
