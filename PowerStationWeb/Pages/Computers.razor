@page "/Computers"
@using Syncfusion.Blazor.Grids

@using PowerStationDomain.models
@using PowerStationInfrastructure.Services
@inject IAdComputerService AdService
@inject Microsoft.AspNetCore.Components.NavigationManager UriHelper


<div class="row">
    <SfGrid DataSource="@GridData" EnableHeaderFocus="true" AllowSelection="true" AllowSorting="true" AllowFiltering="true" EnableVirtualization="true" EnableHover="false" Height="600" RowHeight="38">
        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
        <GridPageSettings PageSize="40"></GridPageSettings>
        <GridSelectionSettings CheckboxOnly="true" PersistSelection="true" Type="SelectionType.Multiple"></GridSelectionSettings
        <GridColumns>
            <GridColumn Type="ColumnType.CheckBox" AllowFiltering="false" AllowSorting="false" Width="60"></GridColumn>
            
           
            <GridColumn Field=@nameof(PowerStationDomain.models.Computer.Name) HeaderText="Name" Width="200"></GridColumn>
            <GridColumn Field=@nameof(PowerStationDomain.models.Computer.Description) HeaderText="EmailAddress" Width="200"></GridColumn>
            <GridColumn Field=@nameof(PowerStationDomain.models.Computer.DisplayName) HeaderText="DisplayName" Width="200"></GridColumn>
            <GridColumn Field=@nameof(PowerStationDomain.models.Computer.UserPrincipalName) HeaderText="UserPrincipalName" Width="200"></GridColumn>
            <GridColumn Field=@nameof(PowerStationDomain.models.Computer.SamAccountName) HeaderText="UserPrincipalName" Width="200"></GridColumn>
        </GridColumns>
    </SfGrid>
</div>

@code {

    public List<Computer> GridData { get; set; } = new List<Computer>();

    protected override void OnInitialized()
    {

        GridData.AddRange(AdService.All() ?? new List<Computer>());
    }

}