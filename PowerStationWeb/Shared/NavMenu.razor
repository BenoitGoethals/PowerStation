@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.SplitButtons

<div class="control-container">
    <SfAppBar ColorMode="AppBarColor.Primary">
        <SfButton CssClass="e-inherit" IconCss="e-icons e-menu"></SfButton>
        <SfDropDownButton CssClass="e-inherit" Content="Overview Principals">
            <DropDownMenuItems>
                <DropDownMenuItem Text="Users" Url="Users"></DropDownMenuItem>
                <DropDownMenuItem Text="Groups" Url="Groups"></DropDownMenuItem>
                <DropDownMenuItem Text="Computers" Url="Computers"></DropDownMenuItem>
                
            </DropDownMenuItems>
        </SfDropDownButton>
        
        <SfDropDownButton CssClass="e-inherit" Content="Details Principals">
            <DropDownMenuItems>
                <DropDownMenuItem Text="Users from group" Url="AddUser"></DropDownMenuItem>
                <DropDownMenuItem Text="Group from a User" Url="AddGroup"></DropDownMenuItem>
                <DropDownMenuItem Text="Shares" Url="Add Computers"></DropDownMenuItem>
               
            </DropDownMenuItems>
        </SfDropDownButton>
        
        <SfDropDownButton CssClass="e-inherit" Content="Add Principals">
            <DropDownMenuItems>
                <DropDownMenuItem Text="Users" Url="AddUser"></DropDownMenuItem>
                <DropDownMenuItem Text="Groups" Url="AddGroup"></DropDownMenuItem>
                <DropDownMenuItem Text="Computers" Url="Add Computers"></DropDownMenuItem>
                
            </DropDownMenuItems>
        </SfDropDownButton>
        
        <SfDropDownButton CssClass="e-inherit" Content="Edit Principals">
            <DropDownMenuItems>
                <DropDownMenuItem Text="Users" Url="AddUser"></DropDownMenuItem>
                <DropDownMenuItem Text="Groups" Url="AddGroup"></DropDownMenuItem>
                <DropDownMenuItem Text="Computers" Url="Add Computers"></DropDownMenuItem>
                
            </DropDownMenuItems>
        </SfDropDownButton>
        
        <SfDropDownButton CssClass="e-inherit" Content="Report Principals">
            <DropDownMenuItems>
                <DropDownMenuItem Text="Users" Url="AddUser"></DropDownMenuItem>
                <DropDownMenuItem Text="Groups" Url="AddGroup"></DropDownMenuItem>
                <DropDownMenuItem Text="Computers" Url="Add Computers"></DropDownMenuItem>
                
            </DropDownMenuItems>
        </SfDropDownButton>

        <SfButton CssClass="e-inherit"Content="Login"></SfButton>
    </SfAppBar>
</div>

<style>
    .control-container .e-btn.e-inherit {
        margin: 0 3px;
    }
</style>